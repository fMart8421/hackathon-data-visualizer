      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "semi-dark-orange" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT event_time AS time, value AS \"temperature\"\nFROM observation\nWHERE metric_key = 'air_temperature' AND mission_id = '$mission' AND $__timeFilter(event_time)\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
