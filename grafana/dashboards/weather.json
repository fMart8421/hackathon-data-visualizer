    {
      "id": 6,
      "type": "timeseries",
      "title": "Air temperature, $mission",
      "description": "Bench session, no GPS.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "options": {
