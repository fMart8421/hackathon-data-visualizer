      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT event_time AS time, value AS \"humidity\"\nFROM observation\nWHERE metric_key = 'relative_humidity' AND mission_id = '$mission' AND $__timeFilter(event_time)\nORDER BY 1;"
