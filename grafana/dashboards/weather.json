          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT count(DISTINCT mission_id) AS value FROM observation\nWHERE metric_key = 'air_temperature' AND mission_id NOT LIKE 'flight-%';"
        }
      ]
