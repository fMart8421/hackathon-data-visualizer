  "time": { "from": "2025-07-28T00:00:00Z", "to": "2025-07-28T21:00:00Z" },
  "templating": {
    "list": [
      {
        "name": "mission",
        "type": "query",
        "label": "Bench session",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
        "query": "SELECT DISTINCT mission_id FROM observation WHERE metric_key = 'air_temperature' AND mission_id NOT LIKE 'flight-%' ORDER BY 1;",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
