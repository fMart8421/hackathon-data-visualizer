          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT count(*) AS value FROM observation\nWHERE metric_key = 'air_temperature' AND mission_id = '$mission';"
        }
