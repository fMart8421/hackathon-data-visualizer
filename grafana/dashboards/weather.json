  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**No location for this data.** Air temperature and relative humidity were measured on the Akel Alcohol3 and CH4 bench rigs, indoors, with no GPS. This satisfies requirement 6 in time-series form only; the geomap form needs a co-located position, which only the synthetic balloon mission currently has (see OPEN-11 in `docs/data-model.md`)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest temperature",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT value FROM observation\nWHERE metric_key = 'air_temperature' AND mission_id = '$mission'\nORDER BY event_time DESC LIMIT 1;"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest humidity",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "humidity", "decimals": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT value FROM observation\nWHERE metric_key = 'relative_humidity' AND mission_id = '$mission'\nORDER BY event_time DESC LIMIT 1;"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bench sessions with T/RH",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
