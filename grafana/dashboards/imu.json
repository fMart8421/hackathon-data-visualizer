{
  "uid": "imu",
  "title": "IMU waveforms (synthetic)",
  "description": "Requirements 4 and 8. SYNTHETIC: nothing in the provided data measured an IMU. Generated under DEC-18 at 100 Hz and stored one block per second, never one row per sample (DEC-07). The $channel and $axis variables drive every panel, so choosing an axis changes what is plotted without editing any JSON. The default window is three minutes: at 100 Hz, six channels, an hour of ride is 2.8 million samples and no browser wants all of them.",
  "tags": ["telemetry", "phase-6", "requirement-4", "requirement-8", "synthetic"],
  "links": [
    {
      "type": "dashboards",
      "title": "Telemetry",
      "tags": ["telemetry"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "2025-06-28T10:20:00Z", "to": "2025-06-28T10:23:00Z" },
  "templating": {
    "list": [
      {
        "name": "channel",
        "type": "query",
        "label": "Channel",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
        "query": "SELECT metric_key FROM metric WHERE kind = 'waveform' ORDER BY 1;",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": { "text": "acceleration", "value": "acceleration" }
      },
      {
        "name": "axis",
        "type": "custom",
        "label": "Axis",
        "query": "X : x, Y : y, Z : z",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic data.** No accelerometer or gyroscope exists anywhere in `data/`. These blocks are generated (DEC-18): gravity on the vertical axis, a pedalling cadence, road noise, and a yaw rate taken from the turns of a real recorded route. The mission is labelled `kind = 'synthetic'`."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Sample rate",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "suffix: Hz", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT max(sample_rate_hz) AS value FROM waveform_block WHERE metric_key = '$channel';"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Blocks stored",
      "description": "One row per second, holding 100 samples per axis (DEC-07).",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT count(*) AS value FROM waveform_block WHERE metric_key = '$channel';"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Samples behind them",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT sum(sample_count) * 3 AS value FROM waveform_block WHERE metric_key = '$channel';"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Vertical RMS",
      "description": "From waveform_envelope. Close to 9.81 for the accelerometer, because the frame is level and gravity sits on z.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT avg(z_rms) AS value FROM waveform_envelope\nWHERE metric_key = '$channel' AND $__timeFilter(block_start_time);"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Full scale",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT max(full_scale) AS value FROM waveform_block WHERE metric_key = '$channel';"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "$channel, axis $axis",
      "description": "Blocks expanded to individual samples. Sample time comes from first_sample_index and the sample rate, not from a clock (DEC-02).",
      "repeat": "axis",
      "repeatDirection": "v",
      "maxPerRow": 1,
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "pointSize": 1 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "-- CASE $axis, not CASE '$axis': the variable is multi-valued, so Grafana\n-- quotes it already and wrapping it again yields ''x''.\nSELECT b.block_start_time + ((s.i - 1) * interval '1 second' / b.sample_rate_hz) AS time,\n       s.sample AS \"sample\"\nFROM waveform_block b\nCROSS JOIN LATERAL unnest(\n         CASE $axis WHEN 'x' THEN b.samples_x\n                    WHEN 'y' THEN b.samples_y\n                    ELSE b.samples_z END\n       ) WITH ORDINALITY AS s(sample, i)\nWHERE b.metric_key = '$channel' AND $__timeFilter(b.block_start_time)\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Envelope over the whole ride, $channel",
      "description": "Per-block min, max and RMS from the waveform_envelope view: the shape of an hour of 100 Hz data in 4731 rows instead of 1.4 million.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 28 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "z max" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-orange" } }] },
          { "matcher": { "id": "byName", "options": "z min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-blue" } }] },
          { "matcher": { "id": "byName", "options": "z rms" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }, { "id": "custom.lineWidth", "value": 2 }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "telemetry-postgres" },
          "rawSql": "SELECT block_start_time AS time, z_min AS \"z min\", z_max AS \"z max\", z_rms AS \"z rms\"\nFROM waveform_envelope\nWHERE metric_key = '$channel'\nORDER BY 1;"
        }
      ]
    }
  ]
}
