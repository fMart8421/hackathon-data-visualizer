# Copy to .env before the first `make up`. .env is gitignored.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_PORT=5432

# Read-only role used by Grafana. Created by db/apply.sh, never by hand.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=grafana_ro

# --- Grafana ----------------------------------------------------------------
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Requirement 9 asks for 1-5 s auto-refresh. Grafana refuses intervals below
# this value, and the default is 5s.
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=1s
